# Legacy camera HAL1
# This legacy provider shares camera-service ownership with cameraserver.
# Do not assign the isolated hal_camera_server role to the fused mediaserver.
typeattribute mediaserver camera_service_server;
typeattribute mediaserver legacy_camera_provider;

allow mediaserver { cameraproxy_service sensor_privacy_service }:service_manager find;
allow mediaserver hal_camera_hwservice:hwservice_manager find;

hal_client_domain(mediaserver, hal_lineage_camera_motor)
